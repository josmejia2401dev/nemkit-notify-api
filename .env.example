NODE_ENV=development
HOST=localhost
PORT=4001
API_PREFIX=/api/v1/notify

# Nombre lógico del nodo que reporta /ready y /health ("casa" o "render").
APP_NODE_NAME=

MONGODB_URI=mongodb://localhost:27017/nemkit_notify
MONGODB_TLS=false
MONGODB_TLS_ALLOW_INVALID=false
MONGODB_USE_SERVER_API=false

JWT_SECRET=replace-with-a-local-secret
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=replace-with-a-local-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:4300

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

LOG_LEVEL=info
LOGS_LOCAL_PATH=./logs
REQUEST_LOG_ENABLED=true

ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-local-admin-password
ADMIN_FULLNAME=Local Admin

# ── Motor de notificaciones ──────────────────────────────────────────────
NOTIFY_QUEUE_CONCURRENCY=5
NOTIFY_JOB_TIMEOUT_MS=20000

# Email (SMTP). Si MAIL_HOST está vacío el canal responde CHANNEL_NOT_CONFIGURED.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@nemkit.local

# SMS (Twilio REST). Deshabilitado por defecto.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WebPush (VAPID). Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@nemkit.local
