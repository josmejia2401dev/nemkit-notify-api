# Entorno
NODE_ENV=development
HOST=0.0.0.0
PORT=4001
API_PREFIX=/api/v1/notify
APP_NODE_NAME=local

# MongoDB
MONGODB_URI=
MONGODB_TLS=false
MONGODB_TLS_ALLOW_INVALID=false
MONGODB_USE_SERVER_API=false

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# CORS y límites
CORS_ORIGINS=https://*.netlify.app,http://localhost:4200,http://localhost:4300
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Logs
LOG_LEVEL=info
LOGS_LOCAL_PATH=./logs
REQUEST_LOG_ENABLED=true

# Seed del administrador (primer arranque)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULLNAME=

# Cola de entregas
NOTIFY_QUEUE_CONCURRENCY=5
NOTIFY_JOB_TIMEOUT_MS=20000

# Mailjet (único proveedor de email)
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Nemkit Notify
